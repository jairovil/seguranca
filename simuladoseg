    // ==================== LÓGICA DO SIMULADO ====================
    
    let questoesAtuais = [];
    
    function embaralharArray(array) {
      for (let i = array.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [array[i], array[j]] = [array[j], array[i]];
      }
      return array;
    }
    
    function carregarNovoSimulado() {
      // Embaralhar todas as questões e pegar 10
      const embaralhadas = embaralharArray([...questoesDB]);
      questoesAtuais = embaralhadas.slice(0, 10);
      renderizarSimulado();
      
      // Esconder resultado anterior
      document.getElementById("resultado").style.display = "none";
      document.getElementById("resultado").innerHTML = "";
    }
    
    function renderizarSimulado() {
      const container = document.getElementById("simulado");
      container.innerHTML = "";
      
      questoesAtuais.forEach((q, idx) => {
        const divQuestao = document.createElement("div");
        divQuestao.className = "questao";
        divQuestao.id = `questao-${idx}`;
        
        divQuestao.innerHTML = `
          <div class="questao-texto">
            <strong>Questão ${idx + 1}:</strong> ${q.enunciado}
          </div>
          <div class="opcoes" id="opcoes-${idx}">
            ${q.opcoes.map((op, optIdx) => `
              <div class="opcao" onclick="selecionarOpcao(${idx}, ${optIdx})">
                <input type="radio" name="q${idx}" id="q${idx}_opt${optIdx}" value="${op.replace(/"/g, '&quot;')}">
                <label for="q${idx}_opt${optIdx}">${op}</label>
              </div>
            `).join('')}
          </div>
          <div class="feedback" id="feedback-${idx}" style="display: none;"></div>
        `;
        
        container.appendChild(divQuestao);
      });
      
      document.getElementById("totalQuestoes").innerText = questoesDB.length;
    }
    
    // Função global para selecionar opção
    window.selecionarOpcao = function(questaoIdx, opcaoIdx) {
      const radio = document.getElementById(`q${questaoIdx}_opt${opcaoIdx}`);
      if (radio) {
        radio.checked = true;
      }
    };
    
    window.corrigirSimulado = function() {
      let acertos = 0;
      const resultados = [];
      
      questoesAtuais.forEach((q, idx) => {
        const selecionado = document.querySelector(`input[name="q${idx}"]:checked`);
        const respostaUsuario = selecionado ? selecionado.value : null;
        const isCorreta = (respostaUsuario === q.correta);
        
        if (isCorreta) acertos++;
        
        const feedbackDiv = document.getElementById(`feedback-${idx}`);
        feedbackDiv.style.display = "block";
        feedbackDiv.className = `feedback ${isCorreta ? "correta" : "incorreta"}`;
        
        if (isCorreta) {
          feedbackDiv.innerHTML = "✅ Correta!";
        } else {
          feedbackDiv.innerHTML = `❌ Incorreta!<br><strong>Resposta correta:</strong> ${q.correta}`;
        }
        
        resultados.push({
          questao: q.enunciado,
          correta: isCorreta,
          respostaCorreta: q.correta
        });
      });
      
      const percentual = (acertos / questoesAtuais.length) * 100;
      let mensagem = "";
      if (percentual >= 70) {
        mensagem = "🎉 Parabéns! Você foi aprovado!";
      } else if (percentual >= 50) {
        mensagem = "📚 Bom trabalho! Continue estudando para melhorar.";
      } else {
        mensagem = "💪 Continue treinando! Revise os conceitos e tente novamente.";
      }
      
      const resultadoDiv = document.getElementById("resultado");
      resultadoDiv.style.display = "block";
      resultadoDiv.innerHTML = `
        <div style="font-size: 1.5em; margin-bottom: 10px;">📊 Resultado Final</div>
        <div style="font-size: 2em; margin-bottom: 10px;">${acertos} / ${questoesAtuais.length}</div>
        <div style="font-size: 1.1em; margin-bottom: 10px;">${percentual}% de acerto</div>
        <div>${mensagem}</div>
      `;
      
      // Rolagem suave para o resultado
      resultadoDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };
    
    window.novoSimulado = function() {
      carregarNovoSimulado();
    };
    
    // Inicializar o simulado
    carregarNovoSimulado();
  </script>
