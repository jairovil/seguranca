      display: flex;
      align-items: center;
      margin: 10px 0;
      padding: 8px 12px;
      background: white;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.2s;
    }

    .opcao:hover {
      background: #e9ecef;
    }

    .opcao input {
      margin-right: 12px;
      cursor: pointer;
      width: 18px;
      height: 18px;
    }

    .opcao label {
      cursor: pointer;
      flex: 1;
      color: #555;
    }

