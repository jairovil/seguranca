      margin-top: 12px;
      padding: 10px;
      border-radius: 8px;
      font-size: 0.9em;
      animation: fadeIn 0.5s;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .feedback.correta {
      background: #d4edda;
      color: #155724;
      border-left: 4px solid #28a745;
    }

    .feedback.incorreta {
      background: #f8d7da;
      color: #721c24;
      border-left: 4px solid #dc3545;
    }

    .botoes {
      display: flex;
      gap: 15px;
      justify-content: center;
      margin-top: 30px;
      flex-wrap: wrap;
    }

